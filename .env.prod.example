# Copy to .env.prod and fill in ALL values. Never commit .env.prod.
DOMAIN=
# openssl rand -base64 24
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -hex 12
MINIO_ACCESS_KEY=
# openssl rand -base64 36
MINIO_SECRET_KEY=
BOOTSTRAP_ADMIN_USER=admin
# openssl rand -base64 18
BOOTSTRAP_ADMIN_PASSWORD=
# Optional. Leave unset (defaults to true) to keep login rate limiting on.
# Set to false only temporarily while debugging; see docs/ops/DEPLOY.md section 10b.
#RATE_LIMIT_ENABLED=true
